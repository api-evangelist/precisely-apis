          "name": "Location By IP Address.",
          "request": {
            "name": "Location By IP Address.",
            "description": {
              "content": "This service accepts an IP address and returns the location coordinates corresponding to that IP address.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "geolocation",
                "v1",
                "location",
                "byipaddress"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "ipAddress",
                  "value": "<string>",
                  "description": "(Required) This is the ip address of network connected device. It must be a standard IPv4 octet and a valid external address."
                }
              ],
              "variable": []
            },
            "header": [
              {
